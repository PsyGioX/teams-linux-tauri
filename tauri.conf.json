{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teams-Linux",
  "version": "0.1.0",
  "identifier": "dev.psygiox.teams-linux",
  "build": {
    "frontendDist": "injected"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'",
      "capabilities": ["default"]
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "tooltip": "Microsoft Teams"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["msteams", "teams"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "publisher": "PsyGioX",
    "category": "SocialNetworking",
    "shortDescription": "Microsoft Teams для Linux с интеграцией GNOME",
    "longDescription": "Неофициальный обёрточный клиент Microsoft Teams (web v2) на Tauri с нативными уведомлениями через freedesktop DBus, треем, глобальными хоткеями mute/camera, синхронизацией темы и Do Not Disturb с GNOME.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libnotify4",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-nice"
        ],
        "desktopTemplate": "packaging/teams-linux.desktop"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libappindicator-gtk3",
          "libnotify",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "libnice"
        ],
        "desktopTemplate": "packaging/teams-linux.desktop"
      }
    }
  }
}
